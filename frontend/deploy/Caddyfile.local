# Local Docker stack only: plain HTTP on localhost, no certificates.
# Production uses deploy/Caddyfile (HTTPS, HSTS, strict CSP).
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /readyz {
		reverse_proxy api:8000
	}
	handle /healthz {
		reverse_proxy api:8000
	}
	handle /tidecloak.json {
		root * /config-public
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
