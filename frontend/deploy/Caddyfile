# Production edge: automatic HTTPS (ACME) for {$CB_DOMAIN}, static SPA, /api reverse proxy.
{
	email {$CB_ACME_EMAIL}
}

{$CB_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# TideCloak needs connect + frame access to its origin (silent SSO iframe) and the Tide
		# enclave origins it uses for sign-in. List them in CB_CSP_IDP_ORIGINS (space separated) and
		# verify sign-in in a browser after any change: the exact origins depend on your Tide setup.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$CB_CSP_IDP_ORIGINS}; frame-src 'self' {$CB_CSP_IDP_ORIGINS}; form-action 'self' {$CB_CSP_IDP_ORIGINS}; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /healthz {
		reverse_proxy api:8000
	}
	handle /readyz {
		reverse_proxy api:8000
	}

	# The adapter file is mounted read-only from the host; never baked into the image.
	handle /tidecloak.json {
		root * /config-public
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
		# Drop query strings from access logs (they can contain search terms).
		format filter {
			wrap json
			request>uri regexp "\?.*$" ""
			request>headers>Authorization delete
			request>headers>Cookie delete
		}
	}
}
