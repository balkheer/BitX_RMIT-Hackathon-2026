# Copy to deploy/.env and fill in. Never commit the filled-in file.
CB_DOMAIN=consentbridge.example.org
CB_ACME_EMAIL=ops@example.org
# Absolute path on the host to the tidecloak.json downloaded from tide-console.
CB_TIDECLOAK_ADAPTER_PATH=/etc/consentbridge/tidecloak.json
# Space-separated origins the browser must reach for TideCloak sign-in (your TideCloak URL and the
# Tide enclave origins your realm uses). Verify sign-in in a browser after changing this.
CB_CSP_IDP_ORIGINS=https://tidecloak.example.org
CB_AGGREGATE_MIN_GROUP_SIZE=5
CB_BACKUP_DIR=./backups
CB_BACKUP_RETENTION_DAYS=14
CB_CHECKPOINT_DIR=./audit-checkpoints
