# Backend configuration. Copy to backend/.env for local development. Placeholders only.
CB_ENVIRONMENT=development
# Runtime connection: least-privileged role (no DELETE; append-only audit).
CB_DATABASE_URL=postgresql+psycopg://cb_app:<app-password>@127.0.0.1:5432/consentbridge
# Migrations only: schema-owner role.
CB_MIGRATION_DATABASE_URL=postgresql+psycopg://cb_owner:<owner-password>@127.0.0.1:5432/consentbridge
# Path to the adapter downloaded from tide-console (Apps > your app > Credentials > Tide adapter).
CB_TIDECLOAK_CONFIG_PATH=../frontend/public/tidecloak.json
# Optional explicit values instead of / overriding the adapter file:
# CB_TIDECLOAK_AUTH_SERVER_URL=http://localhost:8080
# CB_TIDECLOAK_REALM=<realm>
# CB_TIDECLOAK_RESOURCE=<client-id>
# Optional: only if an audience mapper adds this to `aud`.
# CB_TIDECLOAK_AUDIENCE=
# Optional defence in depth: a realm/client role every user must also hold in TideCloak.
# CB_TIDECLOAK_REQUIRED_ROLE=
CB_CORS_ALLOWED_ORIGINS=http://localhost:5173
CB_TRUSTED_HOSTS=localhost,127.0.0.1
CB_AGGREGATE_MIN_GROUP_SIZE=5
CB_RATE_LIMIT_SENSITIVE_PER_MINUTE=30

# Tests (disposable database; it is dropped and recreated on every run):
# CB_TEST_DATABASE_URL=postgresql+psycopg://cb_app:<app-password>@127.0.0.1:5432/consentbridge_test
# CB_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://cb_owner:<owner-password>@127.0.0.1:5432/consentbridge_test
# CB_TEST_SUPERUSER_URL=postgresql+psycopg://postgres:<superuser-password>@127.0.0.1:5432/postgres
